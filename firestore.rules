// ===============================================================
// Assumed Data Model — Noor Al-Iman
// ===============================================================
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - uid: string (required, immutable, == auth.uid)
//   - email: string (required)
//   - displayName: string (optional)
//   - photoUrl: string|null (optional)
//   - providers: list<string> (optional)
//   - emailVerified: bool (optional)
//   - createdAt: timestamp (required on create)
//   - updatedAt: timestamp (required)
//
// Collection: user_locations
// Document ID: {uid}
// Fields:
//   - label: string (required)
//   - latitude: number (required, -90..90)
//   - longitude: number (required, -180..180)
//   - fromGps: bool (optional)
//   - updatedAt: timestamp (required)
//
// Collection: quran_data
// Document ID: {uid}
// Fields:
//   - lastReading: map|null {
//       surah: int, ayah: int, surahLatin: string,
//       surahArabic: string, label?: string, updatedAt?: string
//     }
//   - favorites: list<map> {
//       id: string, type: string, surah: int, ayah?: int,
//       surahLatin: string, surahArabic: string, arabicPreview?: string
//     }
//   - updatedAt: timestamp (required)
//
// Collection: prayer_settings
// Document ID: {uid}
// Fields:
//   - modes: map<string, string> keys fajr|sunrise|dhuhr|asr|maghrib|isha
//            values off|vibration|takbir|adhan
//   - updatedAt: timestamp (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.email is string
        && d.email.size() > 0
        && d.email.size() < 320
        && d.updatedAt is timestamp
        && (!('displayName' in d) || d.displayName is string)
        && (!('photoUrl' in d) || d.photoUrl == null || d.photoUrl is string)
        && (!('providers' in d) || d.providers is list)
        && (!('emailVerified' in d) || d.emailVerified is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp);
    }

    function isValidLocation() {
      let d = request.resource.data;
      return d.label is string
        && d.label.size() > 0
        && d.label.size() < 200
        && d.latitude is number
        && d.latitude >= -90
        && d.latitude <= 90
        && d.longitude is number
        && d.longitude >= -180
        && d.longitude <= 180
        && d.updatedAt is timestamp
        && (!('fromGps' in d) || d.fromGps is bool);
    }

    function isValidQuranData() {
      let d = request.resource.data;
      return d.updatedAt is timestamp
        && (!('lastReading' in d) || d.lastReading == null || d.lastReading is map)
        && (!('favorites' in d) || d.favorites is list);
    }

    function isValidPrayerSettings() {
      let d = request.resource.data;
      return d.modes is map
        && d.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser()
        && hasOnly([
          'uid', 'email', 'displayName', 'photoUrl',
          'providers', 'emailVerified', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(userId)
        && isValidUser()
        && request.resource.data.uid == resource.data.uid
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(userId);
    }

    match /user_locations/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidLocation()
        && hasOnly(['label', 'latitude', 'longitude', 'fromGps', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /quran_data/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidQuranData()
        && hasOnly(['lastReading', 'favorites', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /prayer_settings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidPrayerSettings()
        && hasOnly(['modes', 'updatedAt']);
      allow delete: if isOwner(userId);
    }
  }
}
