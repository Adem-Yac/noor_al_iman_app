// ===============================================================
// Noor Al-Iman — Firestore tables (collections)
// ===============================================================
//
// users/{uid}
//   uid, email, displayName, photoUrl, providers, emailVerified,
//   createdAt, updatedAt
//
// user_locations/{uid}
//   label, latitude, longitude, fromGps, updatedAt
//
// quran_data/{uid}
//   lastReading: map, favorites: list<map>, updatedAt
//
// prayer_settings/{uid}
//   modes: map (fajr|sunrise|dhuhr|asr|maghrib|isha → off|vibration|takbir|adhan)
//   updatedAt
//
// hadith_data/{uid}
//   favorites: list<map>, updatedAt
//
// Règle : chaque doc = un utilisateur (doc id = auth.uid). Owner-only.
// Sync : écritures locales d’abord ; push cloud dès que le réseau revient.
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.email is string
        && d.email.size() > 0
        && d.email.size() < 320
        && d.updatedAt is timestamp
        && (!('displayName' in d) || d.displayName is string)
        && (!('photoUrl' in d) || d.photoUrl == null || d.photoUrl is string)
        && (!('providers' in d) || d.providers is list)
        && (!('emailVerified' in d) || d.emailVerified is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp);
    }

    function isValidLocation() {
      let d = request.resource.data;
      return d.label is string
        && d.label.size() > 0
        && d.label.size() < 200
        && d.latitude is number
        && d.latitude >= -90
        && d.latitude <= 90
        && d.longitude is number
        && d.longitude >= -180
        && d.longitude <= 180
        && d.updatedAt is timestamp
        && (!('fromGps' in d) || d.fromGps is bool);
    }

    function isValidQuranData() {
      let d = request.resource.data;
      return d.updatedAt is timestamp
        && (!('lastReading' in d) || d.lastReading == null || d.lastReading is map)
        && (!('favorites' in d) || d.favorites is list);
    }

    function isValidPrayerSettings() {
      let d = request.resource.data;
      return d.modes is map
        && d.updatedAt is timestamp;
    }

    function isValidHadithData() {
      let d = request.resource.data;
      return d.updatedAt is timestamp
        && (!('favorites' in d) || d.favorites is list);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser()
        && hasOnly([
          'uid', 'email', 'displayName', 'photoUrl',
          'providers', 'emailVerified', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(userId)
        && isValidUser()
        && request.resource.data.uid == resource.data.uid
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(userId);
    }

    match /user_locations/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidLocation()
        && hasOnly(['label', 'latitude', 'longitude', 'fromGps', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /quran_data/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidQuranData()
        && hasOnly(['lastReading', 'favorites', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /prayer_settings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidPrayerSettings()
        && hasOnly(['modes', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /hadith_data/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidHadithData()
        && hasOnly(['favorites', 'updatedAt']);
      allow delete: if isOwner(userId);
    }
  }
}
